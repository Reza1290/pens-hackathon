# Local demo only. Database/provider credentials stay on the server.
DATABASE_URL=postgresql://kasirnusa:local_dev_only@127.0.0.1:54329/kasirnusa
API_PORT=3001
DATA_ROOT=data/raw
# Optional local dataset allowlist (comma-separated internal UUIDs).
ALLOWED_DATASET_IDS=
# Opt-in CLI interpretation: configure on server, then pass --live explicitly.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# Generative adapter: openai, gemini or deepseek; configure a supported model.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
MODEL_MAX_CALLS=20
MODEL_TIMEOUT_MS=15000
# Explicit server opt-in for fact-selection Q&A/custom draft model calls.
QA_LIVE_ENABLED=false
QA_PLANNER_ENABLED=false
QA_JEV_ENABLED=false
ANALYSIS_EXTRACTION_ENABLED=false
# Optional reviewed model rates. Blank means cost is unknown, not free.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
MODEL_ARTIFACT_ROOT=models
