{
  "name": "kasirnusa-account-expansion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "overrides": { "esbuild": "0.28.2" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @kasirnusa/api\" \"npm run dev -w @kasirnusa/web\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @kasirnusa/api",
    "db:migrate": "tsx apps/api/src/cli/migrate.ts",
    "data:prepare": "tsx apps/api/src/cli/prepare.ts",
    "data:import": "tsx apps/api/src/cli/import.ts",
    "data:analyze": "tsx apps/api/src/cli/analyze.ts",
    "data:verify": "tsx apps/api/src/cli/verify.ts",
    "data:interpret": "tsx apps/api/src/cli/interpret.ts",
    "eval": "tsx apps/api/src/cli/eval.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
